<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8</TargetFrameworks>
    <DisableFody>true</DisableFody>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FodyHelpers" />
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="TUnit.Engine" />
    <ProjectReference Include="..\AssemblyToProcess\AssemblyToProcess.csproj" />
    <ProjectReference Include="..\AssertMessage.Fody\AssertMessage.Fody.csproj" />
    <PackageReference Include="Microsoft.CSharp" />
  </ItemGroup>
  <Target Name="RemoveMSTestUsing" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>
  </Target>
</Project>
